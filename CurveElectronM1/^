const { app, BrowserWindow } = require('electron');

app.commandLine.appendSwitch('ignore-gpu-blocklist');
app.commandLine.appendSwitch('enable-gpu-rasterization');
app.commandLine.appendSwitch('enable-oop-rasterization');
app.commandLine.appendSwitch('enable-zero-copy');

// Erstmal zum Testen aktivieren
app.commandLine.appendSwitch('show-fps-counter');

// Performance-Test 1: stabiler Modus
// Wenn FPS zu niedrig sind, testen wir danach den Unlock-Modus.
// app.commandLine.appendSwitch('disable-frame-rate-limit');

function createWindow() {
  const win = new BrowserWindow({
    width: 1400,
    height: 900,
    backgroundColor: '#000000',
    autoHideMenuBar: true,
    title: 'Curve Fever M1',
    webPreferences: {
      nodeIntegration: false,
      contextIsolation: true,
      sandbox: true,
      backgroundThrottling: false,
      webgl: true,
      spellcheck: false,
    },
  });

  win.setMenuBarVisibility(false);
  win.loadURL('https://curvefever.pro');
}

app.whenReady().then(createWindow);

app.on('window-all-closed', () => {
  app.quit();
});



